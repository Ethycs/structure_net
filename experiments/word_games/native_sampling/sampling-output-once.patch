+struct llama_sampling_output llama_get_sampling_output_ith(llama_context * ctx, int32_t i) {
+    ctx->synchronize();
+
+    // Use internal getters: public getters would each synchronize all backends.
+    // output_reorder() is idempotent, preserving existing output-row semantics.
+    llama_sampling_output output = {};
+    output.n_vocab = ctx->get_model().vocab.n_tokens();
+    output.sampled_probs      = ctx->get_sampled_probs_ith(i);
+    output.sampled_logits     = ctx->get_sampled_logits_ith(i);
+    output.sampled_candidates = ctx->get_sampled_candidates_ith(i);
+    output.sampled_probs_count      = static_cast<uint32_t>(ctx->get_sampled_probs_count(i));
+    output.sampled_logits_count     = static_cast<uint32_t>(ctx->get_sampled_logits_count(i));
+    output.sampled_candidates_count = static_cast<uint32_t>(ctx->get_sampled_candidates_count(i));
+    output.sampled_token = ctx->get_sampled_token_ith(i);
+    if (!output.sampled_probs && !output.sampled_logits) {
+        output.logits = ctx->get_logits_ith(i);
+    }
+    return output;
+}
